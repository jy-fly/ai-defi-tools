{
  "_说明": "monitors 里按资产写阈值，每条阈值会自动展开成一条独立报警规则；rules 里可以写更复杂的组合规则（可留空）",
  "intervalSeconds": 300,
  "defaultCooldownMinutes": 60,
  "telegram": {
    "_说明": "mode=digest 时一轮检查的所有报警合并成一条消息（按池子分组）；single 则每条报警各发一条。fields 控制推送里包含哪些行，跑 `node aave/index.js fields` 看全部可用值，`preview` 看渲染效果",
    "mode": "digest",
    "digestIncludeOthers": true,
    "digestLayout": "overview+detail",
    "digestDedupeFields": true,
    "fields": [
      "supplyAPY",
      "reserveSize",
      "availableLiquidity",
      "utilizationRate",
      "supplyCap",
      "borrowLine",
      "riskParams",
      "status"
    ],
    "heartbeatFields": [
      "supplyAPY",
      "utilizationRate",
      "reserveSizeUsd",
      "availableLiquidityUsd"
    ],
    "showRuleId": true,
    "showAaveLink": true,
    "showTimestamp": true,
    "silentSeverities": [
      "info"
    ],
    "notifyOnRecover": true,
    "quietHours": {
      "enabled": false,
      "start": 1,
      "end": 7,
      "timezone": "Asia/Shanghai",
      "exceptSeverities": [
        "critical"
      ]
    },
    "rateLimit": {
      "maxPerHour": 20,
      "exceptSeverities": [
        "critical"
      ]
    }
  },
  "heartbeatHours": 0,
  "statePath": "aave/data/state.json",
  "historyIntervalMinutes": 60,
  "mongo": {
    "_说明": "MONGODB_URI 走环境变量/Secrets，不写在这里（含密码）。不设 MONGODB_URI 就完全不碰 mongo",
    "db": "defi",
    "collection": "aave_reserves"
  },
  "rpcUrls": [
    "https://ethereum-rpc.publicnode.com",
    "https://eth.drpc.org"
  ],
  "monitors": [
    {
      "symbol": "USDT",
      "address": "0xdAC17F958D2ee523a2206206994597C13D831ec7",
